# ts-playwright server runtime environment (example).
# Copy to .env and fill real values. Do NOT commit a filled .env.

# Container image to run. Replace with your real registry tag or a locally built image.
TS_PLAYWRIGHT_IMAGE=ts-playwright/server:local

APP_PORT=8000

# Global authentication gate. Secure by default — when unset, every /api route (except
# login/register) requires a session cookie, a personal access token (PAT bearer), or the machine
# x-api-key. Set APP_REQUIRE_AUTH=0 ONLY for a trusted, isolated local network to open the data plane.
# APP_REQUIRE_AUTH=1

# Machine credential for the desktop agent / CI (sent as the X-API-KEY header). Optional now that
# real user auth + PATs exist, but still REQUIRED in production unless APP_REQUIRE_API_KEY=0:
# an empty value makes the server refuse to start when NODE_ENV=production.
APP_API_KEY=

# Master key for envelope-encrypting stand secrets at rest (AES-256-GCM). Opt-in: when unset,
# secrets are stored as plaintext. Generate with the KEK utility; back it up SEPARATELY from data.
# APP_KEK=

APP_OTP_AUTOREPLACE=false
APP_RUN_TIMEOUT_MS=900000
APP_PLAYWRIGHT_DEFAULT_TIMEOUT_MS=60000

# Runner image + execution mode.
APP_DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.52.0-jammy
APP_DOCKER_RUNNER_MODE=npx
APP_DOCKER_WORKSPACE_TRANSPORT=auto

# Per-container shared memory. Value is allocated PER concurrent runner, so total host usage
# is roughly APP_DOCKER_SHM_SIZE * APP_MAX_CONCURRENT_RUNS.
APP_DOCKER_SHM_SIZE=1g
APP_DOCKER_IPC=
APP_DOCKER_NETWORK=
APP_DOCKER_ADD_HOSTS=

# Runner resource limits (Phase 0 / P0-T01). Recommended in production; empty = no limit.
# These bound a single runner container so a runaway scenario cannot exhaust the host.
APP_DOCKER_CPUS=2
APP_DOCKER_MEMORY=2g
APP_DOCKER_PIDS_LIMIT=512
# Drop all Linux capabilities from runner containers (safe with Chromium's setuid sandbox).
APP_DOCKER_CAP_DROP=ALL
# Keep OFF unless Chromium is launched with --no-sandbox: no-new-privileges breaks the
# setuid sandbox in the Microsoft Playwright image. Verify against a live run before enabling.
APP_DOCKER_NO_NEW_PRIVILEGES=false

# Max runner containers executing at once, across single and folder/stage runs (Phase 0 / P0-T02).
APP_MAX_CONCURRENT_RUNS=2

# Seed entities (optional). Use placeholders only in committed examples — never real secrets.
# APP_ACCOUNTS_JSON=[{"login":"<login>","password":"<password>","2fa_otp":"<base32-totp-secret>"}]
# APP_MERCHANTS_JSON=[{"name":"<merchant>","admin_login":"<login>","env_ids":["<env>"]}]
# APP_POOLS_JSON=[{"id":"trace-default","name":"Default trace IDs","kind":"trace_id","allocation_strategy":"template","template":"{date}_{testName}_{seq}"}]
# APP_POOL_ITEMS_JSON=[]
APP_ACCOUNTS_JSON=[]
APP_MERCHANTS_JSON=[]
APP_POOLS_JSON=[]
APP_POOL_ITEMS_JSON=[]
