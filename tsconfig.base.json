{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ts-playwright/shared": [
        "packages/shared/src/index.ts"
      ],
      "@ts-playwright/runner": [
        "packages/runner/src/index.ts"
      ]
    }
  }
}
