{
  "name": "ts-playwright",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-agent-assets.mjs",
    "clean": "node ./scripts/clean.mjs",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:agent": "npm run dev -w @ts-playwright/agent",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
