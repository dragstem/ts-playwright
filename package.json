{
  "name": "ts-playwright",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-agent-assets.mjs",
    "clean": "node ./scripts/clean.mjs",
    "dev:server": "pnpm --filter @ts-playwright/server dev",
    "dev:agent": "pnpm --filter @ts-playwright/agent dev",
    "start:server": "pnpm --filter @ts-playwright/server start",
    "start:agent": "pnpm --filter @ts-playwright/agent start",
    "playwright:install": "pnpm --filter @ts-playwright/agent exec playwright install chromium",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
